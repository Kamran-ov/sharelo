# Copy to .env for local runs outside Docker. Test values only; never use in production.
DATABASE_URL=postgres://sharelo:sharelo@localhost:5432/sharelo
SECRET_KEY=change-me
DEBUG=1
GOOGLE_CLIENT_ID=
# Only needed if the Vite proxy sets changeOrigin: true (then add http://localhost:5173).
CSRF_TRUSTED_ORIGINS=

# --- compose.prod.yml (see README "Run it for real on your laptop") ---
# SECRET_KEY: generate your own: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Local mode: HTTPS=0, ALLOWED_HOSTS=localhost,127.0.0.1, open http://localhost:8000.
# Tunnel mode: HTTPS=1, ALLOWED_HOSTS=<host>.trycloudflare.com,
#              CSRF_TRUSTED_ORIGINS=https://<host>.trycloudflare.com. GOOGLE_CLIENT_ID above stays optional.
ALLOWED_HOSTS=localhost,127.0.0.1
HTTPS=0
